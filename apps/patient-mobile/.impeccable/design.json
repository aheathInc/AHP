  "narrative": {
    "northStar": "Human Care",
    "overview": "Human Care brings the compact search, category grid, grouped appointment details and dark floating navigation of the inspected DocSpot stills into the official A-Health identity. Medical Blue, restrained teal, Open Sans and quiet surfaces support patients finding care and understanding their next action.\n\nThis implemented system supersedes the previous petrol palette, system-font and large-hero direction. The reference guides composition; existing clinical meaning, available data, navigation and native behavior remain authoritative.",
    "keyCharacteristics": [
      "Compact search and six care destinations on home.",
      "Rounded flat surfaces with explicit clinical labels.",
      "Adaptive reading width and accessible semantic colors."
    ],
    "rules": [
      {
        "name": "The Clinical Meaning Rule",
        "body": "Amber means attention and clay means a problem or urgency; status must also have a text label.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic palette roles in light, dark and accessibility modes.",
      "Do retain all five labelled navigation destinations and existing workflows.",
      "Do use real clinician images only when available; otherwise use initials.",
      "Do respect text scaling, reduced motion and native navigation."
    ],
    "donts": [
      "Do not invent ratings, availability, prices, clinician photos or clinical states.",
      "Do not use amber or clay for decoration.",
      "Do not add decorative gradients or glass to operational surfaces.",
      "Do not distort, recolor or add effects to the supplied logo."
    ]
  }
