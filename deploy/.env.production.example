# Run: python3 deploy/configure.py init
# Fill these values on the server; never commit the resulting .env.production.
AHP_WEB_HOST=staff.example.invalid
AHP_API_HOST=api.example.invalid
ACME_EMAIL=owner@example.invalid
AHP_IMAGE_TAG=local
AHP_DB_CA_FILE=./database-ca.crt
# Use connection_limit=2 as an initial per-service pool, then capacity-test.
# CA certificate must match the managed database. Separate runtime/migration roles.
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET=
NEXTAUTH_SECRET=
GATEWAY_SHARED_SECRET=
USSD_CONTEXT_KEY=
# Production OTP delivery requires a real Africa's Talking account/sender.
AT_USERNAME=
AT_API_KEY=
SMS_SENDER_ID=
# Optional profiles: payment, ai, research, gateway. Keep payments off until approved.
PAYMENTS_LIVE_ENABLED=false
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
CHAT_MODEL_ENDPOINT=
CHAT_MODEL_KEY=
CHAT_MODEL_NAME=
