NODE_ENV=development
PORT=4007
DATABASE_URL=postgresql://ahealth:LOCAL_DB_PASSWORD_REQUIRED@localhost:55432/ahealth_dev?schema=public
JWT_SECRET=replace-with-at-least-32-random-local-characters
JWT_ISSUER=a-health
JWT_AUDIENCE=a-health-api

# Care Continuity. SMS defaults OFF per patient until explicit opt-in.
CARE_REMINDER_INTERVAL_SECONDS=30
CARE_REMINDER_WINDOW_MINUTES=120
CARE_REMINDER_BATCH=100

# AFPE: deploy the forward migration before starting workers.
# Clinical-lead-approved ICD-10/context rules. Empty list requires explicit clinician category selection.
AFPE_DIAGNOSIS_RULES_JSON=[]
# Optional contextual inference adapter; HTTPS and an authorized processor are required.
# AFPE_AI_URL=https://your-approved-inference-adapter.example/follow-up
# AFPE_AI_KEY=provide-through-private-runtime-configuration
# Optional outbound SMS/WhatsApp adapter and signed inbound callback.
# AFPE_MESSAGING_URL=https://your-messaging-adapter.example/messages
# AFPE_MESSAGING_KEY=provide-through-private-runtime-configuration
# AFPE_MESSAGING_WEBHOOK_SECRET=provide-a-random-secret-of-at-least-32-characters
# GOTHOMIS_WEBHOOK_SECRET=provide-a-random-secret-of-at-least-32-characters

# Production activation/scoring requires clinical-governance approval of the deployed scoring policy.
AFPE_CLINICAL_POLICY_APPROVED=false
